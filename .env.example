# ==============================================================================
# Churnveda - Environment Configuration Template
# Populate these variables in your Netlify / Hosting provider environment settings
# DO NOT commit real secrets, private keys, or passwords to source control
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Server & Database Settings
# ------------------------------------------------------------------------------
NODE_ENV="production"
PORT=3000
APP_URL="https://your-site.netlify.app"

# PostgreSQL Database URL (e.g. Supabase, Railway, Neon, AWS RDS)
# If left empty, the application uses local disk SQLite fallback (data/nochurn.db)
DATABASE_URL=""

# ------------------------------------------------------------------------------
# 2. Frontend Supabase & API Configuration (Public)
# ------------------------------------------------------------------------------
# In Netlify (Site Configuration -> Environment Variables), define:
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
VITE_SITE_URL="https://your-site.netlify.app"

# Optional: Direct backend URL if frontend and backend are hosted on separate domains
VITE_API_URL=""

# Public Razorpay Key for browser checkout modal
VITE_RAZORPAY_KEY_ID=""

# Legacy Next.js compatibility aliases (Supported automatically if previously set)
# NEXT_PUBLIC_SUPABASE_URL=""
# NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# NEXT_PUBLIC_SITE_URL="https://your-site.netlify.app"

# ------------------------------------------------------------------------------
# 2B. Backend Supabase & Storage Configuration (Private - Railway Environment)
# ------------------------------------------------------------------------------
# In Railway (Project Settings -> Variables), define:
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SESSION_SECRET=""
ALLOWED_ORIGINS="https://your-site.netlify.app,https://yourcustomdomain.com"

# ------------------------------------------------------------------------------
# 3. Google Gemini AI API Configuration
# ------------------------------------------------------------------------------
# Get your Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=""

# ------------------------------------------------------------------------------
# 4. Razorpay Payments & Subscriptions (Currency: USD)
# ------------------------------------------------------------------------------
# Retrieve from Razorpay Dashboard (Settings -> API Keys)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Razorpay Subscription Plan IDs (Created in Razorpay Dashboard for USD billing)
RAZORPAY_STARTER_MONTHLY_PLAN_ID=""
RAZORPAY_STARTER_ANNUAL_PLAN_ID=""
RAZORPAY_GROWTH_MONTHLY_PLAN_ID=""
RAZORPAY_GROWTH_ANNUAL_PLAN_ID=""
RAZORPAY_ENTERPRISE_MONTHLY_PLAN_ID=""
RAZORPAY_ENTERPRISE_ANNUAL_PLAN_ID=""

# ------------------------------------------------------------------------------
# 5. WhatsApp Business Cloud API (Outbound Retention Messaging)
# ------------------------------------------------------------------------------
# Meta Developer Portal -> WhatsApp -> API Setup
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""

# ------------------------------------------------------------------------------
# 6. Resend Email Delivery API (Outbound Retention Emails)
# ------------------------------------------------------------------------------
# From https://resend.com/api-keys
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Churnveda <onboarding@yourdomain.com>"

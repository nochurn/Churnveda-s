# ==============================================================================
# Churnveda - Environment Configuration Template
# Populate these variables in your Netlify / Hosting provider environment settings
# DO NOT commit real secrets, private keys, or passwords to source control
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Server & Database Settings
# ------------------------------------------------------------------------------
NODE_ENV="production"
PORT=3000
APP_URL="https://your-site.netlify.app"

# PostgreSQL Database URL (e.g. Supabase, Railway, Neon, AWS RDS)
# If left empty, the application uses local disk SQLite fallback (data/nochurn.db)
DATABASE_URL=""

# ------------------------------------------------------------------------------
# 2. Frontend Supabase & API Configuration (Public - Catalyst Slate / Netlify)
# ------------------------------------------------------------------------------
# IMPORTANT:
# - VITE_SUPABASE_URL must be the HTTPS Project URL: https://[project-ref].supabase.co
# - DO NOT paste the postgresql:// connection URI here! (Put postgresql:// in DATABASE_URL below)
# - For Vite SPA, these variables are baked into the static bundle during "npm run build".
#   If variables are added/changed in Catalyst Slate / Netlify, trigger a fresh redeploy.
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
VITE_SITE_URL="https://your-site.catalyst-or-netlify.app"

# Optional: Direct backend URL if frontend and backend are hosted on separate domains
VITE_API_URL=""

# Public Razorpay Key for browser checkout modal
VITE_RAZORPAY_KEY_ID=""

# Legacy Next.js compatibility aliases (Supported automatically if previously set)
# NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# NEXT_PUBLIC_SITE_URL="https://your-site.catalyst-or-netlify.app"

# ------------------------------------------------------------------------------
# 2B. Backend Supabase & Storage Configuration (Private - Railway / Catalyst Server)
# ------------------------------------------------------------------------------
# In Backend Host (Variables / Environment settings), define:
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY=""
SESSION_SECRET=""
ALLOWED_ORIGINS="https://your-site.catalyst-or-netlify.app,https://yourcustomdomain.com"

# ------------------------------------------------------------------------------
# 3. Google Gemini AI API Configuration
# ------------------------------------------------------------------------------
# Get your Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=""

# ------------------------------------------------------------------------------
# 4. Razorpay International USD Subscriptions (INR Settlement)
# ------------------------------------------------------------------------------
# Retrieve from Razorpay Dashboard (Settings -> API Keys)
# Keep Key Secret and Webhook Secret strictly server-side (Never commit or expose to frontend)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# International Payments & Recurring Foreign Card Mandate Activation
# Set to "true" after Razorpay approves International Card Payments + Subscriptions
RAZORPAY_INTERNATIONAL_ENABLED="false"

# RBI Export Purpose Code for Software / SaaS export settlement to Indian bank account
RAZORPAY_PURPOSE_CODE="P0802"

# Whether to enable a separate domestic INR pricing flow for Indian visitors (defaults to false; strict fixed USD)
ENABLE_DOMESTIC_INR_PRICING="false"

# Razorpay Fixed USD Subscription Plan IDs (Created in Razorpay Dashboard -> Subscriptions -> Plans)
# Starter: $29.00 USD / month (2900 cents)
RAZORPAY_STARTER_MONTHLY_PLAN_ID=""
RAZORPAY_STARTER_ANNUAL_PLAN_ID=""

# Growth: $79.00 USD / month (7900 cents)
RAZORPAY_GROWTH_MONTHLY_PLAN_ID=""
RAZORPAY_GROWTH_ANNUAL_PLAN_ID=""

# Enterprise: $349.00 USD / month (34900 cents)
RAZORPAY_ENTERPRISE_MONTHLY_PLAN_ID=""
RAZORPAY_ENTERPRISE_ANNUAL_PLAN_ID=""

# ------------------------------------------------------------------------------
# 5. WhatsApp Business Cloud API (Outbound Retention Messaging)
# ------------------------------------------------------------------------------
# Meta Developer Portal -> WhatsApp -> API Setup
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""

# ------------------------------------------------------------------------------
# 6. Resend Email Delivery API (Outbound Retention Emails)
# ------------------------------------------------------------------------------
# From https://resend.com/api-keys
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Churnveda <onboarding@yourdomain.com>"

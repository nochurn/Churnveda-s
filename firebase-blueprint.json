{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account profile and workspace details",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 255 },
        "fullName": { "type": "string", "maxLength": 128 },
        "companyName": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "enum": ["Admin", "Viewer"], "maxLength": 64 },
        "workspaceId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email"]
    },
    "Workspace": {
      "title": "Workspace",
      "description": "Tenant workspace record with owner details",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 128 },
        "owner_id": { "type": "string", "maxLength": 128 },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "owner_id"]
    },
    "WorkspaceMember": {
      "title": "WorkspaceMember",
      "description": "Workspace membership and role binding",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "workspace_id": { "type": "string", "maxLength": 128 },
        "user_id": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "enum": ["owner", "admin", "member"], "maxLength": 32 },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "workspace_id", "user_id", "role"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Customer account tracked for churn risk and retention",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "workspaceId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 255 },
        "email": { "type": "string", "format": "email", "maxLength": 255 },
        "mrr": { "type": "number" },
        "plan": { "type": "string", "maxLength": 64 },
        "riskScore": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "workspaceId", "name", "email"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile document owned by the authenticated user"
    },
    "/workspaces/{workspaceId}": {
      "schema": { "$ref": "#/entities/Workspace" },
      "description": "Tenant workspace document"
    },
    "/workspaces/{workspaceId}/members/{memberId}": {
      "schema": { "$ref": "#/entities/WorkspaceMember" },
      "description": "Workspace authorized members list"
    },
    "/workspaces/{workspaceId}/customers/{customerId}": {
      "schema": { "$ref": "#/entities/Customer" },
      "description": "Customer retention records within an authorized workspace"
    }
  }
}
